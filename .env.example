# 复制成 .env 后按需填写。.env 不会进版本库。
#
#   cp .env.example .env
#
# 全部留空也能正常跑：人机会退化成规则策略（不联网、不花钱，但也不会聊天）。

# ---------------------------------------------------------------- 部署
# 站点域名。必填，deploy/deploy.sh 会用它生成 Caddy 站点块。
POKER_DOMAIN=poker.example.com

# ---------------------------------------------------------------- 人机
# 至少填一个 key，人机才会真正调用大模型。填几个就按座位轮流用，
# 某一家挂了会自动冷却 60 秒并切到别家。
KIMI_API_KEY=
DEEPSEEK_API_KEY=
# 银联云走 code-tool 网关，填【网关签发的 token】（uuid 形式），不是上游真 key
YINLIANYUN_API_KEY=

# 指定只用某一家：kimi | deepseek | yinlianyun | auto（默认 auto，有哪个 key 用哪个）
# POKER_BOT_PROVIDER=auto

# 覆盖模型名。默认 Kimi 用 moonshot-v1-8k，DeepSeek 用 deepseek-chat，
# 银联云用 deepseek-v4-flash。
# 【注意】这个键是【全局】的：auto 模式下多家一起用时，它会同时盖到每一家头上，
# 而模型名不通用——填了 deepseek-chat，Kimi 那路就会直接 4xx。
# 只想给某一家换模型，就用 POKER_BOT_PROVIDER 把它单独指出来。
# 一次决策约 1500 输入 + 120 输出 token，便宜的模型完全够用。
# POKER_BOT_MODEL=

# 覆盖接入点。走自建代理，或用 Moonshot 海外站点（https://api.moonshot.ai/v1）时填。
# 同样是全局的，多家一起用时别填。
# POKER_BOT_BASE_URL=

# 单次请求超时（毫秒）。超时就退回规则策略，牌桌不会卡住。
# 行动时限默认 45 秒，所以这里给到 8~15 秒都很安全。
# 不填的话按各家自己的预设：多数是 8 秒，银联云（deepseek-v4-flash 带思维链）30 秒。
# 注意：带思维链的模型单轮就要十几秒，这个数给小了是【静默】退化——
# 牌桌照常进行，人机只是每手都悄悄退回规则策略。
# 还有：这个键也是全局的，填了就把银联云那 30 秒也一起盖掉。
# POKER_BOT_TIMEOUT_MS=

# 思维链开关：on（默认，照模型原样）| off（让它别想，直接答）。
# 只对【会思考的模型】有意义，目前只有银联云那两个 deepseek-v4-* 认这个开关；
# Kimi、DeepSeek 的默认模型本来就不带思维链，填了 off 也只会在日志里说一句
# "没有已知的关思维链开关，仍按原样调用"，不会改变任何请求。
#
# 银联云 + deepseek-v4-flash 实测（46 题题库各跑 2 遍，单轮模式）：
#
#              延迟 p50 / p95      模型自己答对的
#   带思维链    5.7s / 27.6s        63/64
#   不思考      1.9s /  4.0s        46/46
#
# 也就是快 3 倍、p95 快 7 倍，而这套题上看不出判断力差别。但这只有 46 道题，
# 且不思考那轮被网关吞掉了一部分样本（见下），所以别把"没差别"当成定论——
# 真要下结论就自己再跑一遍，两个 --think 各来一次对着看：
#     YINLIANYUN_API_KEY=... node scripts/agent-eval.mjs --provider yinlianyun \
#         --mode single --think off --repeat 2
#
# 【和这个开关无关的一件事】这个网关会间歇性回 502「上游模型服务报错」，
# 三次测量分别是 35% / 0% / 33%，两种设置下都出现过，跟开不开思维链没有关系。
# 人机遇到 502 会退回规则策略，牌桌照常进行，只是那一手打得笨一点。
# POKER_BOT_THINKING=on

# 单轮回答的 token 上限。动作 JSON 本身只有二十来个 token，但**思维链和正文
# 共用这个预算** —— 给小了不是答得短，是答到一半被截断、解析失败、整手悄悄
# 退回规则策略，日志上只有一行"输出无法解析成 JSON"。
# 实测 deepseek-v4-flash 光思维链就要 572~3372 个 token。
# 给大了不多花钱：思维链的 token 你照付，上限只决定这笔钱换不换得回一个答案。
# POKER_BOT_MAX_TOKENS=4096

# 胜率估算。计算是【分片】的：跑一小片就让出事件循环，所以牌桌不会被卡住。
# 因此这里有两个性质完全不同的参数：
#
#   POKER_BOT_EQUITY_CHUNK_MS  单片占用事件循环的时间。这个必须【小】——
#                              这段时间里全桌都被冻结（Node 单线程）。8ms 感知不到。
#   POKER_BOT_EQUITY_MS        总墙钟上限。这个可以【大方给】。行动时限 45 秒，
#                              人机本来还要等 LLM 一两秒，几百毫秒毫无影响。
#
# 20000 次约 ±0.5% 误差。慢机器只是算得久一点，而不是被迫降精度。
# 设 POKER_BOT_EQUITY_SIMS=0 可以完全关掉胜率估算。
# POKER_BOT_EQUITY_SIMS=20000
# POKER_BOT_EQUITY_MS=1500
# POKER_BOT_EQUITY_CHUNK_MS=8

# ---------------------------------------------------------------- agent 人机
# 把人机从「一次调用」升级成「多轮工具调用」。默认关闭。
#
# 关掉（默认）：我们先按「对手随机两张牌」把胜率算好塞进提示词，模型读那一个数
#               然后直接出动作。问题是那个数系统性偏乐观——对手越紧越离谱。
# 打开：        胜率变成一个【工具】。模型先读行动序列和对手画像，自己判断
#               「这人打成这样，范围大概前 10%」，再按那个范围要一次胜率，
#               必要时用两个范围各算一次看结论会不会反转，最后才出动作。
#               同一手 AK：对随机牌 66% 胜率，对「只玩前 5%」的人只有 47%。
#
# 代价：一次决策要 2~6 次模型调用（token 大概是原来的 3~4 倍），延迟多几秒。
# 要求：模型必须支持 function calling。不支持就会调用失败，然后自动退回单轮。
# POKER_AGENT=on

# agent 专用的模型名（要支持 function calling）。没填就退回用 POKER_BOT_MODEL。
# POKER_AGENT_MODEL=

# 一次决策最多几步。每步是一次模型调用，所以这个数直接决定花多少钱。
# 能调工具的是 (步数 - 1) 次，最后一步被强制用来提交动作。
# 6 步 = 5 次工具调用：读画像 -> 算胜率 -> 三个下注尺度各算一次 -> 出动作。
# 这是上限不是开销：模型一提交动作就停，多数决策两三步就结束。
# 想省钱可以调回 4（够「画像 + 胜率 + 一个尺度」，但横向比尺度就不够了）。
# POKER_AGENT_MAX_STEPS=6

# 整次决策的墙钟上限（毫秒）。超了就退回单轮人机，牌桌不会卡住。
# 要跟着步数一起调，否则多给的步数用不上——闸门半路落下，前面花的钱全作废。
# 算法：30s 闸门 + 1.5s 兜底算胜率 + 8s 兜底的单轮调用 = 40s，
# 行动时限 45 秒还剩 5 秒余量。再往上加就得先把行动时限也调大。
# POKER_AGENT_MAX_MS=30000
#
# 【接银联云时注意】deepseek-v4-flash 一次 agent 决策要 4~5 轮工具调用，
# 每轮都带思维链：题库实测整次决策 p50 24s、p95 撞满 60s。也就是说用默认的
# 30s 闸门，大约一半的决策会退回单轮版——钱花了，多轮的好处没拿到。
# 要在这家上开 agent，就把 POKER_ACTION_TIMEOUT 加到 90 秒左右，
# 再把这个闸门提到 70000。不想改时限的话，这家更适合关着 agent 用单轮。

# agent 每次蒙特卡洛的墙钟预算（estimate_equity 和 plan_bet 各算一次）。
# 模型可能调好几次，所以给得比
# 单轮版（POKER_BOT_EQUITY_MS）小一点。20000 次模拟的误差只有 ±0.5%，
# 少算一点完全无感。
# POKER_AGENT_EQUITY_MS=1200

# ---------------------------------------------------------------- 牌桌初始设置
# 牌桌配置存在内存里，容器重启就回到代码默认值。写在这里可以免去每次部署完
# 重新点一遍设置页。房主之后仍然能在页面上改，只是那个改动重启后会丢。
#
# 校验范围与设置页完全一致：非法值会在启动日志里报错并回退到默认值，
# 不会被静默接受。启动日志最后会打印实际生效的配置。

# 盲注。简写形式；也可以用 POKER_SMALL_BLIND / POKER_BIG_BLIND 单独设（优先级更高）
# POKER_BLINDS=100/200

# 起始筹码。建议是大盲的 100 倍左右 —— 盲注 100/200 配 1000 筹码只有 5 个大盲，
# 那个深度上没有翻牌后博弈可谈，正确打法只剩全下或弃牌。
# POKER_STARTING_STACK=20000

# 前注（0 = 不收）
# POKER_ANTE=0

# 行动时限，单位【秒】（5~300）
# POKER_ACTION_TIMEOUT=45

# 每手之间的间隔，单位【秒】（1~60）
# POKER_NEXT_HAND_DELAY=6

# 是否自动开下一手
# POKER_AUTO_NEXT_HAND=true

# ---------------------------------------------------------------- 语音连麦
# 音频是浏览器之间点对点直传的（WebRTC mesh），能直连的时候不经过这台服务器。
#
# 两张桌子的语音是分开的：德州桌说的话掼蛋桌听不到，反之亦然。
#
# 前提：页面必须跑在 HTTPS 上（或本机 localhost），否则浏览器不给用麦克风。
# 用 deploy/deploy.sh 部署的话 Caddy 已经把证书办好了，不用额外做什么。
#
# 【重要】要给异地的朋友用，TURN 不是可选项，见下面。

# 整体开关。off = 前端连按钮都不显示
# POKER_VOICE=on

# 一张桌子最多几个人上麦（2~8）。mesh 拓扑下连接数按 n² 涨，8 人是 28 条连接。
# POKER_VOICE_MAX=8

# STUN：负责告诉双方各自的公网地址。默认这三家都是实际发过 STUN 请求验证能用的
# （Google 那台 stun.l.google.com 在墙内打不通，要用得自己填）。
# 逗号分隔；填 none 表示不问任何外部服务器，只能局域网内直连。
# POKER_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.cloudflare.com:3478

# ------------------------------- TURN 中转（异地必需）
#
# 光有 STUN 的话，两边都在运营商大内网（CGNAT）里就是打不通的——
# 国内异地家宽这是常态，不是偶发。症状很有迷惑性：
# 上麦成功、名单里能看到对方、但谁也听不见谁。
#
# deploy/deploy.sh 会自动做完下面这一整套：生成密钥、起 coturn 容器、
# 放行端口、跑连通性自检。所以【自建的话这几行不用手填】。
#
# 想确认到底通没通：
#     docker exec poker node server/turn-check.js
#
# 自建 coturn（推荐）：密钥两边共享，服务端按人现签短期凭据。
# 不要填固定密码——ICE 配置是发给每一个打开网页的人的，
# 固定密码等于把中转服务器的账号公开挂在网上。
# POKER_TURN_URL=turn:1.2.3.4:3478,turn:1.2.3.4:3478?transport=tcp
# POKER_TURN_SECRET=<deploy.sh 自动生成的 64 位十六进制>
# 临时凭据的有效期，秒，范围 60~86400，默认 21600（6 小时）
# POKER_TURN_TTL=21600

# 用别人家的 TURN 服务时才填这两个（那种情况下你改不了对方的配置，
# 只能用它给的固定账号密码）。和 POKER_TURN_SECRET 二选一。
# POKER_TURN_USERNAME=
# POKER_TURN_CREDENTIAL=

# ---------------------------------------------------------------- 服务
# PORT=8080
# HOST=0.0.0.0

# ======================= 掼蛋桌 =======================
# 掼蛋是同一个服务上的第二张桌子，地址 /guandan，和德州桌互不影响。
# 时间一律填【秒】。

# 每一步的行动时限，超时会自动代打（10~300）
# GUANDAN_ACTION_TIMEOUT=40

# 一局打完到下一局开始的间隔（2~60）
# GUANDAN_NEXT_DEAL_DELAY=8

# 是否自动开下一局；关掉就要房主每局手动点"开始这一局"
# GUANDAN_AUTO_NEXT_DEAL=true

# ======================= 热词 =======================
# 热词是同一个服务上的第三张桌子，地址 /hotword，1v1 猜同一个词，谁先猜中谁赢。
# 时间一律填【秒】。

# 一局最长多久（30~600）。到点两边都没猜中就算平局、公布答案。
# 默认 90 秒，是照着"能被完整看完、能录成一段短视频"选的。
# 提示的三档是按【比例】走的，所以这个数一改，三档会跟着一起拉开
# HOTWORD_ROUND_LIMIT=90

# 每次猜完的冷却（0~30，可以填小数）。设成 0 就是纯拼手速，不建议——
# 这个冷却是为了让赢家是想得对的人，不是打字快的人。
# 90 秒的局里 3 秒冷却只够猜 30 次、太紧，所以默认压到 1.5
# HOTWORD_GUESS_COOLDOWN=1.5

# 偷看一次冻住自己多久（0~120）。偷看能看到对手【目前最好的】那个词和排名，
# 这个时长就是它的价格。调高了没人会用（终局是几秒定生死），调低了会变成白嫖
# HOTWORD_PEEK_FREEZE=8

# 一局最多偷看几次（0~9）。填 0 等于关掉偷看
# HOTWORD_PEEK_LIMIT=2

# 允许偷看（true/false）
# HOTWORD_PEEK=true

# 允许提示（true/false）。提示按【时间】开，跟谁猜了多少次无关，两个人永远拿到
# 同一份：开局给字数、四分之一处给类别、五分之三处给首字（90 秒局＝0/23/54 秒）。
# 关掉的话一局就是纯凭本事的 90 秒，没有任何兜底
# HOTWORD_HINTS=true

# 换一份词库。默认用 server/hotword/data/，里面要有 vocab.bin / vocab.txt / answers.txt
# HOTWORD_DATA_DIR=/opt/poker/mywords
